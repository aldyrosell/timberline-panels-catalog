# Copy to .env.local and fill in. .env.local is gitignored.
# The same four values go into the Vercel project's environment variables.

# Public. These are compiled into the browser bundle, which is expected and safe —
# a Sanity project ID is not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=iy9c2prg
NEXT_PUBLIC_SANITY_DATASET=production

# Server only. Viewer-permission token, used to read unpublished drafts for preview.
# Never rename this to NEXT_PUBLIC_* — that would hand every visitor the ability to
# read your drafts.
SANITY_API_READ_TOKEN=

# Server only. Any long random string you invent. The identical value must be set as
# the secret on the Sanity webhook, or published changes will not reach the site.
SANITY_REVALIDATE_SECRET=

# Where preview edit links open. http://localhost:3333 locally; https://grainora-demo.sanity.studio in Vercel.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
